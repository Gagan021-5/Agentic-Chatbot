# ═══════════════════════════════════════════════════════════════
# RentPrompts Backend (FastAPI) — Environment Variables
# ═══════════════════════════════════════════════════════════════

# --- React / CORS ---
REACT_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Auth (set AUTH_MODE=api_key in production) ---
AUTH_MODE=none
AUTH_SECRET_KEY=rp-backend-secret-change-me-in-prod

# --- Gemini (embeddings + LLM) ---
GEMINI_API_KEY=

# --- Groq (fast triage / extraction / preview) ---
GROQ_API_KEY=

# --- OpenRouter (prompt generation / SEO / test-prompt) ---
OPENROUTER_API_KEY=

# --- Upstash Redis (sessions — same keys as former Node.js backend) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Payload CMS ---
PAYLOAD_CMS_URL=http://localhost:3000
PAYLOAD_CMS_API_KEY=

# --- Murf TTS (audio preview) ---
MURF_API_KEY=

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./data/chromadb

# --- Service ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development
APP_VERSION=1.0.0

# --- RAG / Cache ---
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.3
CACHE_TTL_SECONDS=3600
SESSION_TTL_SECONDS=1800
